import random

random.seed(1)

N = 4
MAX_PAIRS = N * (N - 1) // 2

population = [
    [2, 4, 3, 1],
    [1, 2, 3, 4],
    [2, 1, 3, 2],
    [4, 3, 1, 1],
]

def conflicts(state):
    count = 0
    for i in range(N):
        for j in range(i + 1, N):
            if state[i] == state[j] or abs(state[i] - state[j]) == j - i:
                count += 1
    return count

def roulette_select(pop, fits):
    total = sum(fits)
    r = random.uniform(0, total)
    running = 0
    for state, f in zip(pop, fits):
        running += f
        if r <= running:
            return state
    return pop[-1]

def crossover(p1, p2, point=2):
    return p1[:point] + p2[point:], p2[:point] + p1[point:]

for gen in range(1, 3):
    print(f"\n========== GENERATION {gen} (current population) ==========")

    conf = [conflicts(s) for s in population]
    fits = [MAX_PAIRS - c for c in conf]
    total = sum(fits)
    probs = [f / total for f in fits]

    for i, s in enumerate(population):
        print(f"State-{i+1}: {s}  conflicts={conf[i]}  fitness={fits[i]}  prob={probs[i]:.2f}")
    print("Total conflicts:", sum(conf), "| Total fitness:", total)

    new_pop = []
    while len(new_pop) < len(population):
        p1 = roulette_select(population, fits)
        p2 = roulette_select(population, fits)
        c1, c2 = crossover(p1, p2)
        print(f"Parents {p1} & {p2} -> Children {c1} & {c2}")
        new_pop += [c1, c2]

    population = new_pop

    print(f"\n--- New population after generation {gen} ---")
    for i, s in enumerate(population):
        print(f"Child-{i+1}: {s}  conflicts={conflicts(s)}")
